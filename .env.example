# Local/container runtime configuration. Copy to .env (never commit .env).
APP_BIND_IP=127.0.0.1
APP_PORT=3000

# Required only at runtime, and only on the server. Do NOT use VITE_ prefix.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Select/verify available models on OpenRouter before rollout.
CHAT_PRIMARY_LLM=minimax/minimax-m3:free
CHAT_FALLBACK_LLM=openrouter/free
CHAT_USE_FALLBACK=true

CHAT_TEMPERATURE=0.2
CHAT_TOP_P=0.8
CHAT_MAX_TOKENS=450
CHAT_TIMEOUT_MS=45000

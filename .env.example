APP_BIND_IP=127.0.0.1
APP_PORT=3000

# Supabase Auth (identity provider). Leave empty to run without sign-in: protected routes then fail closed.
# SUPABASE_URL: project URL, for example https://<project-ref>.supabase.co  (used by FastAPI for JWKS and by the server)
# SUPABASE_PUBLISHABLE_KEY: publishable key, server-side only; never a service_role or secret key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional. Defaults: issuer = <SUPABASE_URL>/auth/v1, audience = authenticated. FastAPI accepts only ES256 and RS256.
# SUPABASE_JWT_ISSUER=
# SUPABASE_JWT_AUDIENCE=authenticated

# Only used by FastAPI. Never commit your real key.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
CHAT_PRIMARY_LLM=google/gemma-3-27b-it
CHAT_FALLBACK_LLM=openrouter/free
CHAT_USE_FALLBACK=true
CHAT_TEMPERATURE=0.2
CHAT_TOP_P=0.8
CHAT_MAX_TOKENS=1200
CHAT_TIMEOUT_MS=45000

# Analysis quotas. Off by default. Empty, 0, false, no or off mean off; true, 1, yes or on mean on. Any other value stops
# the analysis endpoints with QUOTA_CONFIGURATION_INVALID.
ANALYSIS_QUOTA_ENFORCED=false

# Frontend server functions call FastAPI here. Compose sets it; for a local run without Compose use http://127.0.0.1:8000.
# FASTAPI_INTERNAL_URL=http://127.0.0.1:8000

# PostgreSQL for development (compose.dev.yml). Replace the placeholder in your local .env.
# Use letters and digits only, so the password needs no URL encoding in DATABASE_URL.
POSTGRES_DB=rckt
POSTGRES_USER=rckt
POSTGRES_PASSWORD=<POSTGRES_PASSWORD>

# Database roles (see docs/PHASE2_DB_RLS.md). Each variable is a different login; never reuse one for another purpose.
# DATABASE_URL: the FastAPI runtime. Login role rckt_app (no SUPERUSER, no BYPASSRLS, owns no table).
# Production: point it at the managed PostgreSQL instead (postgresql+asyncpg://user:pass@host:5432/db).
# Leave DATABASE_URL empty to run without persistence, as in the Phase 1 MVP.
DATABASE_URL=postgresql+asyncpg://rckt:<POSTGRES_PASSWORD>@db:5432/rckt
# DATABASE_OPERATOR_URL: the CLI only (python -m app.cli ...). One personal login per operator, member of rckt_operator.
# DATABASE_OPERATOR_URL=postgresql+asyncpg://<operator-login>:<PASSWORD>@<host>:5432/<database>
# DATABASE_MIGRATION_URL: migrations only (alembic upgrade). Login role rckt_migrator. Never set in the runtime.
# DATABASE_MIGRATION_URL=postgresql+asyncpg://rckt_migrator:<PASSWORD>@<host>:5432/<database>
# Pool tuning (defaults in app/core/config.py).
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=5
# DATABASE_CONNECT_TIMEOUT_SECONDS=5

# End-to-end tests (bun run test:e2e). Four logins, one purpose each; every URL names a database ending in _test,
# which is dropped and recreated on every run. Never point them at the development or staging database.
# E2E_DISPOSABLE_INSTANCE: required before any drop. Set it only for an instance that exists for the tests alone
# (a dedicated container or CI service). It must equal: yes-this-instance-is-disposable-and-exclusive
# The script refuses to run if the instance holds another user database, a remote host, or any name but rckt_e2e_test.
E2E_DISPOSABLE_INSTANCE=
# E2E_ADMIN_DATABASE_URL: drops and creates the test database only (a role that may do so; e.g. the local superuser).
# E2E_MIGRATION_DATABASE_URL: applies migrations (rckt_migrator).
# E2E_OPERATOR_DATABASE_URL: seeds organizations and users through the CLI (a member of rckt_operator).
# E2E_APP_DATABASE_URL: the backend under test (rckt_app). The only one the backend receives.
E2E_ADMIN_DATABASE_URL=postgresql+asyncpg://rckt:<POSTGRES_PASSWORD>@127.0.0.1:55432/rckt_e2e_test
E2E_MIGRATION_DATABASE_URL=postgresql+asyncpg://rckt_migrator:<PASSWORD>@127.0.0.1:55432/rckt_e2e_test
E2E_OPERATOR_DATABASE_URL=postgresql+asyncpg://<operator-login>:<PASSWORD>@127.0.0.1:55432/rckt_e2e_test
E2E_APP_DATABASE_URL=postgresql+asyncpg://rckt_app:<PASSWORD>@127.0.0.1:55432/rckt_e2e_test

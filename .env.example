APP_BIND_IP=127.0.0.1
APP_PORT=3000

# Only used by FastAPI. Never commit your real key.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
CHAT_PRIMARY_LLM=google/gemma-3-27b-it
CHAT_FALLBACK_LLM=openrouter/free
CHAT_USE_FALLBACK=true
CHAT_TEMPERATURE=0.2
CHAT_TOP_P=0.8
CHAT_MAX_TOKENS=1200
CHAT_TIMEOUT_MS=45000

# PostgreSQL for development (docker-compose.override.yml). Replace the placeholder in your local .env.
# Use letters and digits only, so the password needs no URL encoding in DATABASE_URL.
POSTGRES_DB=rckt
POSTGRES_USER=rckt
POSTGRES_PASSWORD=change-me-local-only
# Production: point DATABASE_URL at the managed PostgreSQL instead (postgresql+asyncpg://user:pass@host:5432/db).
# Leave DATABASE_URL empty to run without persistence, as in the Phase 1 MVP.
DATABASE_URL=postgresql+asyncpg://rckt:change-me-local-only@db:5432/rckt

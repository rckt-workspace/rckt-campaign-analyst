APP_BIND_IP=127.0.0.1
APP_PORT=3000

# Supabase Auth (identity provider). Leave empty to run without sign-in: protected routes then fail closed.
# SUPABASE_URL: project URL, for example https://<project-ref>.supabase.co  (used by FastAPI for JWKS and by the server)
# SUPABASE_PUBLISHABLE_KEY: publishable key, server-side only; never a service_role or secret key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Only used by FastAPI. Never commit your real key.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
CHAT_PRIMARY_LLM=google/gemma-3-27b-it
CHAT_FALLBACK_LLM=openrouter/free
CHAT_USE_FALLBACK=true
CHAT_TEMPERATURE=0.2
CHAT_TOP_P=0.8
CHAT_MAX_TOKENS=1200
CHAT_TIMEOUT_MS=45000

# PostgreSQL for development (compose.dev.yml). Replace the placeholder in your local .env.
# Use letters and digits only, so the password needs no URL encoding in DATABASE_URL.
POSTGRES_DB=rckt
POSTGRES_USER=rckt
POSTGRES_PASSWORD=<POSTGRES_PASSWORD>
# Production: point DATABASE_URL at the managed PostgreSQL instead (postgresql+asyncpg://user:pass@host:5432/db).
# Leave DATABASE_URL empty to run without persistence, as in the Phase 1 MVP.
DATABASE_URL=postgresql+asyncpg://rckt:<POSTGRES_PASSWORD>@db:5432/rckt

# End-to-end tests: a database whose name ends in _test, recreated on every run (never the development database).
E2E_DATABASE_URL=postgresql+asyncpg://rckt:<POSTGRES_PASSWORD>@127.0.0.1:55432/rckt_e2e_test
